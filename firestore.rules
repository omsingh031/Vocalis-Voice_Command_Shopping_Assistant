rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each anonymous user can only read/write their own subtree.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared product catalog: readable by any authenticated (incl. anonymous) user,
    // writable only from the trusted server context (Cloud Functions admin SDK).
    match /catalog/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
